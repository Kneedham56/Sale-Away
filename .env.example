NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Server only
SUPABASE_SECRET_KEY=sb_secret_...
SUPABASE_DB_URL=postgresql://postgres.your-project:PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres
GEMINI_API_KEY=

# eBay: mock | sandbox | production
EBAY_ENV=mock
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_RU_NAME=
EBAY_CLIENT_ID_SANDBOX=
EBAY_CLIENT_SECRET_SANDBOX=
EBAY_RU_NAME_SANDBOX=
# 32 random bytes, base64 (encrypts her eBay refresh token)
EBAY_TOKEN_KEY=
# 32-80 characters; also entered on eBay's account-deletion notification page
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=https://sale-away.vercel.app/api/ebay/account-deletion
# Publishing listings from the app (Phase 4); leave false until she's ready
EBAY_WRITE_ENABLED=false
# Bearer secret for /api/cron/ebay-sync (Vercel Cron + GitHub Actions)
CRON_SECRET=
